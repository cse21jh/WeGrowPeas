  chatPartner: {fileID: 11400000, guid: de2037bd7e84c1042b45d2e4111e97ac, type: 2}
  messages:
  - triggerId: GoldPlant
    isMandatory: 0
    messageText: "\uD669\uAE08 \uC2DD\uBB3C\uC744 \uBF51\uC558\uAD6C\uB098!"
    delayAfterPrevious: 1.5
  - triggerId: GoldPlant
    isMandatory: 0
    messageText: "\uD669\uAE08 \uC2DD\uBB3C\uC740 \uBCF8\uC778\uC758 \uBAA8\uB4E0
      \uC800\uD56D\uB825\uC774 80\uC744 \uB118\uB294 \uC6B0\uC218\uD55C \uAC1C\uCCB4\uC5D0\uAC8C
      \uAC00\uB054 \uB098\uC624\uB294 \uC2DD\uBB3C\uC774\uC57C."
    delayAfterPrevious: 1.5
  - triggerId: GoldPlant
    isMandatory: 0
    messageText: "\uD669\uAE08 \uC2DD\uBB3C\uC740 \uC6E8\uC774\uBE0C\uAC00 \uC9C0\uB098\uB3C4
      \uC800\uD56D\uB825\uC774 \uAC10\uC18C\uD558\uC9C0 \uC54A\uC9C0."
    delayAfterPrevious: 1.5
  - triggerId: GoldPlant
    isMandatory: 0
    messageText: "\uC131\uB2A5 \uD655\uC2E4\uD55C \uCE5C\uAD6C\uB2C8\uAE4C \uD669\uAE08
      \uC2DD\uBB3C\uC744 \uB9CE\uC774 \uBF51\uC544 \uBD10!"
    delayAfterPrevious: 1.5
  - triggerId: 3
    isMandatory: 1
    messageText: "\uB18D\uC7A5\uC774 \uC0DD\uACA8\uC11C \uADF8\uB7F0\uAC00 \uBC8C\uB808\uAC00
      \uC810\uC810 \uB9CE\uC544\uC9C0\uB124..."
    delayAfterPrevious: 1.5
  - triggerId: 3
    isMandatory: 1
    messageText: "\uC870\uB9CC\uAC04 \uD574\uCDA9 \uC6E8\uC774\uBE0C\uAC00 \uB4F1\uC7A5\uD560
      \uAC83 \uAC19\uC544."
    delayAfterPrevious: 1.5
  - triggerId: 3
    isMandatory: 1
    messageText: "\uC0C8\uB85C\uC6B4 \uC6E8\uC774\uBE0C\uAC00 \uB4F1\uC7A5\uD560
      \uAC83 \uAC19\uC744 \uB54C\uB294 \uC544\uCE68\uC5D0 \uC0C1\uC810\uC5D0\uC11C
      \uC644\uB450\uCF69 \uCD94\uAC00\uB97C \uD655\uC778\uD574 \uBCF4\uBA74 \uC88B\uC744
      \uAC70\uC57C!"
    delayAfterPrevious: 1.5
  - triggerId: 3
    isMandatory: 1
    messageText: "\uBCF4\uD1B5\uC740 \uBBF8\uB9AC\uBBF8\uB9AC \uC0C8 \uD615\uC9C8\uC758
      \uC644\uB450\uCF69\uC744 \uB4E4\uC5EC\uB193\uAC70\uB4E0."
    delayAfterPrevious: 1.5
  - triggerId: 8
    isMandatory: 1
    messageText: "\uC694\uC998 \uB4E4\uC5B4 \uBC14\uB78C\uC774 \uC810\uC810 \uC2EC\uD574\uC9C0\uACE0
      \uC788\uC5B4..."
    delayAfterPrevious: 1.5
  - triggerId: 8
    isMandatory: 1
    messageText: "\uC870\uB9CC\uAC04 \uBC14\uB78C \uC6E8\uC774\uBE0C\uAC00 \uB4F1\uC7A5\uD560
      \uAC83 \uAC19\uC73C\uB2C8 \uBBF8\uB9AC \uB300\uBE44\uD574 \uC918!"
    delayAfterPrevious: 1.5
  - triggerId: 13
    isMandatory: 1
    messageText: "\uB545\uC774 \uCD95\uCD95\uD574\uC9C0\uB294 \uB290\uB08C\uC774
      \uB4E4\uC5B4..."
    delayAfterPrevious: 1.5
  - triggerId: 13
    isMandatory: 1
    messageText: "\uC870\uB9CC\uAC04 \uD64D\uC218 \uC6E8\uC774\uBE0C\uAC00 \uB4F1\uC7A5\uD560
      \uAC83 \uAC19\uC740\uAC78?"
    delayAfterPrevious: 1.5
  - triggerId: 18
    isMandatory: 1
    messageText: "\uC5B4\uC81C \uD558\uB298 \uBD24\uC5B4? \uC800 \uBA40\uB9AC\uC5D0
      \uBA39\uAD6C\uB984\uC774 \uB07C\uAE30 \uC2DC\uC791\uD588\uC5B4."
    delayAfterPrevious: 1.5
  - triggerId: 18
    isMandatory: 1
    messageText: "\uACE7 \uD3ED\uC6B0 \uC6E8\uC774\uBE0C\uAC00 \uB4F1\uC7A5\uD558\uACA0\uB294\uAC78?"
    delayAfterPrevious: 1.5
  - triggerId: HeavyRainUnlock
    isMandatory: 1
    messageText: "\uC774\uBC88 \uD3ED\uC6B0 \uC6E8\uC774\uBE0C\uB97C \uD3EC\uD568\uD574\uC11C,
      \uC55E\uC73C\uB85C \uB098\uC62C \uC0C8\uB85C\uC6B4 \uC6E8\uC774\uBE0C\uB4E4\uC740
      \uC870\uAE08 \uD2B9\uC774\uD55C \uADDC\uCE59\uC744 \uAC00\uC9C0\uACE0 \uC788\uC5B4."
    delayAfterPrevious: 1.5
  - triggerId: HeavyRainUnlock
    isMandatory: 1
    messageText: "\uD55C \uD615\uC9C8\uC774 \uACC4\uC808\uC5D0 \uB530\uB77C \uBCC0\uD654\uD558\uB294
      \uD55C \uC30D\uC758 \uC6E8\uC774\uBE0C\uC5D0 \uB300\uC751\uD558\uAC8C \uB3FC."
    delayAfterPrevious: 1.5
  - triggerId: HeavyRainUnlock
    isMandatory: 1
    messageText: "\uC608\uB97C \uB4E4\uC5B4 \uD3ED\uC6B0\uC758 \uD68C\uC0C9 \uC720\uC804\uC790\uB9CC
      \uC788\uB294 \uC2DD\uBB3C\uC774, \uAC00\uBB44\uC5D0\uB294 \uC798 \uC0B4\uC544\uB0A8\uB294
      \uAC70\uC57C."
    delayAfterPrevious: 1.5
  - triggerId: HeavyRainUnlock
    isMandatory: 1
    messageText: "\uADF8\uB9AC\uACE0 \uC5EC\uB984\uACFC \uAC00\uC744\uC5D0\uB294
      <color=#F59B17>\uD3ED\uC6B0</color>\uAC00, \uBD04\uACFC \uACA8\uC6B8\uC5D0\uB294
      <color=#F59B17>\uAC00\uBB44</color>\uC774 \uCC3E\uC544\uC624\uB294 \uAC70\uC9C0..."
    delayAfterPrevious: 1.5
  - triggerId: HeavyRainUnlock
    isMandatory: 1
    messageText: "\uCD94\uD6C4\uC5D0 \uBCFC \uCD94\uC704 \uD615\uC9C8\uACFC \uAD00\uB828\uD574\uC11C\uB294
      \uBD04\uACFC \uC5EC\uB984\uC5D0\uB294 <color=#F59B17>\uB354\uC704</color>\uAC00,
      \uAC00\uC744\uACFC \uACA8\uC6B8\uC5D0\uB294 <color=#F59B17>\uCD94\uC704</color>\uAC00
      \uCC3E\uC544\uC62C \uAC70\uC57C."
    delayAfterPrevious: 1.5
  - triggerId: HeavyRainUnlock
    isMandatory: 1
    messageText: "\uC870\uAE08 \uAE4C\uB2E4\uB86D\uACA0\uC9C0\uB9CC, \uB300\uC2E0
      \uC774\uB7F0 \uC6E8\uC774\uBE0C\uB4E4\uC740 \uC720\uB9AC\uD55C \uC720\uC804\uC790\uAC00
      \uD558\uB098\uB77C\uB3C4 \uC788\uB2E4\uBA74 \uC0DD\uC874 \uD655\uB960\uC774
      \uC57D\uAC04\uC774\uB098\uB9C8 \uC62C\uB77C\uAC00\uB2C8\uAE4C \uB108\uBB34
      \uB099\uB2F4\uD558\uC9C0 \uB9C8!"
    delayAfterPrevious: 1.5
  - triggerId: HeavyRainUnlock
    isMandatory: 1
    messageText: "\uACC4\uC808\uC740 5\uC77C\uB9C8\uB2E4 \uBC14\uB00C\uACE0 \uC774\uD399\uD2B8\uAC00
      \uBCF4\uC774\uB2C8 \uCC38\uACE0\uD558\uACE0!"
    delayAfterPrevious: 1.5
  - triggerId: 23
    isMandatory: 1
    messageText: "\uB0A0\uC528\uAC00 \uB9CE\uC774 \uC300\uC300\uD574\uC84C\uB124..."
    delayAfterPrevious: 1.5
  - triggerId: 23
    isMandatory: 1
    messageText: "\uC870\uB9CC\uAC04 \uCD94\uC704 \uC6E8\uC774\uBE0C\uAC00 \uB4F1\uC7A5\uD560
      \uAC83 \uAC19\uC73C\uB2C8 \uB300\uBE44\uD574 \uC918!"
    delayAfterPrevious: 1.5
  - triggerId: 23
    isMandatory: 1
    messageText: "\uC544, \uC5EC\uB984\uC774 \uCC3E\uC544\uC624\uBA74 \uCD94\uC704
      \uB300\uC2E0 \uB354\uC704\uAC00 \uC62C \uC218 \uC788\uB294 \uAC83\uB3C4 \uC78A\uC9C0
      \uB9D0\uACE0!"
    delayAfterPrevious: 1.5
