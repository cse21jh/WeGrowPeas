  entries:
  - image: {fileID: 21300000, guid: c4d243ffe843fd64dadbd896f05db4c0, type: 3}
    text: "2100\uB144 \uACBD\uC758 \uC9C0\uAD6C, \uAE30\uD6C4 \uBCC0\uD654\uB85C
      \uC778\uD574 \uB9CE\uC740 \uC2DD\uBB3C\uB4E4\uC774 \uC0B4 \uACF3\uC744 \uC783\uC5C8\uACE0,
      \uB18D\uC791\uBB3C\uB3C4 \uC608\uC678\uB294 \uC544\uB2C8\uC5C8\uB2E4."
  - image: {fileID: 21300000, guid: c4d243ffe843fd64dadbd896f05db4c0, type: 3}
    text: "\uADF8 \uC5EC\uD30C\uB85C \uBE44\uCD95\uD574\uB454 \uC2DD\uB7C9\uC774
      \uACE0\uAC08\uB418\uAE30 \uC2DC\uC791\uD558\uACE0\u2026"
  - image: {fileID: 21300000, guid: abeda947f7bf69945abae38f0cfb7f35, type: 3}
    text: "\uC2EC\uAC01\uC131\uC744 \uB290\uB080 \uC815\uBD80\uB294 \uAD6D\uAC00
      \uCC28\uC6D0\uC5D0\uC11C \uC0C8\uB85C\uC6B4 \uC2DD\uB7C9\uC744 \uC5F0\uAD6C\uD55C\uB2E4\uB294
      \uACF5\uACE0\uBB38\uC744 \uAC8C\uC2DC\uD558\uAC8C \uB41C\uB2E4."
  - image: {fileID: 21300000, guid: abeda947f7bf69945abae38f0cfb7f35, type: 3}
    text: "\uB048\uC9C8\uAE34 \uC0DD\uC874\uB825\uACFC \uD48D\uBD80\uD55C \uC601\uC591\uC18C\uB97C
      \uC9C0\uB2CC \uC2DD\uBB3C\uC744 \uAC00\uC838\uC624\uBA74 \uC5B4\uB9C8\uC5B4\uB9C8\uD55C
      \uD3EC\uC0C1\uAE08\uC744 \uC900\uB2E4\uACE0 \uD558\uB294\uB370\u2026"
  - image: {fileID: 21300000, guid: 8a73f6e90f0712d4f8460bd4abd58b07, type: 3}
    text: "\uB9C8\uCE68 \uC2DD\uBB3C\uACFC \uC18C\uD1B5\uC774 \uAC00\uB2A5\uD55C
      \uD2B9\uC774\uD55C \uB2A5\uB825\uC744 \uAC00\uC9C0\uACE0 \uC788\uB294 \uB2F9\uC2E0!"
  - image: {fileID: 21300000, guid: 8a73f6e90f0712d4f8460bd4abd58b07, type: 3}
    text: "\uB9C9\uB300\uD55C \uD3EC\uC0C1\uAE08\uC744 \uBAA9\uD45C\uB85C 2\uB144
      \uAC04\uC758 \uAE38\uACE0\uB3C4 \uC9E7\uC740 \uC5EC\uC815\uC744 \uC2DC\uC791\uD558\uAC8C
      \uB41C\uB2E4\u2026"
