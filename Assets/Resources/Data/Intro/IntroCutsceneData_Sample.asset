  entries:
  - image: {fileID: 21300000, guid: a6e5632f477c18040b3975233699cd16, type: 3}
    text: "\uC624\uB798 \uC804, \uC778\uAC04 \uAD34\uBB3C,\\n\uB450 \uC885\uC871\uC774
      \uC138\uC0C1\uC744\\n\uB2E4\uC2A4\uB838\uC2B5\uB2C8\uB2E4."
  - image: {fileID: 21300000, guid: c8b601f40c68da945a32bcf9a94fcc51, type: 3}
    text: "\uC5B4\uB290 \uB0A0 \uB450 \uC885\uC871\uAC04\uC5D0\\n\uC804\uC7C1\uC774
      \uBC1C\uBC1C\uD588\uC2B5\uB2C8\uB2E4."
  - image: {fileID: 21300000, guid: 98b9d94300aa58148970fc85ae8d99be, type: 3}
    text: "\uAE38\uACE0 \uAE34 \uC2F8\uC6C0 \uB05D\uC5D0,\\n\uC778\uAC04\uC774 \uC2B9\uB9AC\uD588\uC2B5\uB2C8\uB2E4."
  - image: {fileID: 21300000, guid: 98b9d94300aa58148970fc85ae8d99be, type: 3}
    text: "\uADF8\uB4E4\uC740 \uB9C8\uBC95 \uC8FC\uBB38\uC744\\n\uC774\uC6A9\uD558\uC5EC
      \uAD34\uBB3C\uB4E4\uC744\\n\uB545 \uC18D\uC5D0 \uBD09\uC778\uD588\uC2B5\uB2C8\uB2E4."
  - image: {fileID: 0}
    text: "\uB9CE\uC740 \uC2DC\uAC04\uC774 \uD750\uB978 \uB4A4..."
  - image: {fileID: 21300000, guid: 06505e1669b681141812fb026dfec599, type: 3}
    text: "\uC5D0\uBD07 \uC0B0,\\n201X\uB144"
  - image: {fileID: 21300000, guid: e162b5be9ac9e8c4cafb3e1419738188, type: 3}
    text: "\uC804\uC124\uC5D0 \uB530\uB974\uBA74\\n\uC0B0\uC5D0 \uC624\uB978 \uC774\uB294
      \uC808\uB300\\n\uB3CC\uC544\uC624\uC9C0 \uBABB\uD55C\uB2E4\uACE0 \uD569\uB2C8\uB2E4."
