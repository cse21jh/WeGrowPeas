  messages:
  - triggerId: Default
    isMandatory: 0
    messageText: "\uAE30\uD6C4 \uBCC0\uD654\uB85C \uC778\uD574 \uBE44\uCD95\uD574\uB454
      \uC2DD\uB7C9\uC774 \uACE0\uAC08\uB418\uACE0 \uC788\uC2B5\uB2C8\uB2E4. "
    delayAfterPrevious: 0
  - triggerId: Default
    isMandatory: 0
    messageText: "\uB048\uC9C8\uAE34 \uC0DD\uC874\uB825\uACFC \uD48D\uBD80\uD55C
      \uC601\uC591\uC18C\uB97C \uC9C0\uB2CC \uC2DD\uBB3C\uC744 \uAC00\uC838\uC624\uB294
