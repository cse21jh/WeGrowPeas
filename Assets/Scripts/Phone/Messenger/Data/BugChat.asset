  messages:
  - triggerId: 5
    isMandatory: 1
    messageText: "\uD558\uD558! \uC6B0\uB9AC\uB294 \uC2DD\uBB3C\uB4E4\uC744 \uAD34\uB86D\uD788\uAE30
      \uC704\uD574 \uB098\uD0C0\uB09C \uBC8C\uB808\uB4E4!"
    delayAfterPrevious: 1
  - triggerId: 5
    isMandatory: 1
    messageText: "\uC9C0\uAE08\uBD80\uD130 \uB18D\uC7A5 \uAC00\uC7A5\uC790\uB9AC
      \uACF3\uACF3\uC5D0\uC11C \uC8FC\uAE30\uC801\uC73C\uB85C \uB098\uD0C0\uB098
      \uB108\uD76C \uC2DD\uBB3C\uB4E4\uC744 \uB9DB\uC788\uAC8C \uBA39\uC5B4 \uC8FC\uB9C8!"
    delayAfterPrevious: 1
  - triggerId: 5
    isMandatory: 1
    messageText: "\uC2DD\uBB3C\uB4E4\uC744 \uC7A1\uC544\uBA39\uAE30 \uC804\uC5D0
      \uD074\uB9AD\uD574\uC11C \uC7A1\uC9C0 \uC54A\uC73C\uBA74 \uD070\uC77C \uB0A0
      \uAC70\uB2E4!"
    delayAfterPrevious: 1
  - triggerId: 5
    isMandatory: 1
    messageText: "\uB9C8\uC6B0\uC2A4\uB97C \uC798 \uBCF4\uBA74 \uB4F1\uC7A5 \uBC29\uD5A5\uC774
      \uBCF4\uC77C \uC218\uB3C4...?"
    delayAfterPrevious: 1
  - triggerId: 10
    isMandatory: 0
    messageText: "\uC0C8\uB85C\uC6B4 \uCE5C\uAD6C\uB4E4\uC744 \uC12D\uC678\uD588\uB2E4!"
    delayAfterPrevious: 1
  - triggerId: 10
    isMandatory: 0
    messageText: "\uC774\uB984\uD558\uC5EC \uC9C1\uC9C4 \uBC8C\uB808\uC640 \uACE1\uC120
      \uBC8C\uB808! \uB2A5\uB825\uC740 \uBE44\uBC00\uC774\uB2E4!"
    delayAfterPrevious: 1
  - triggerId: 15
    isMandatory: 0
    messageText: "\uD06C\uAE30\uB97C \uB2E4\uC591\uD558\uAC8C \uB9CC\uB4E4\uC5B4
      \uC654\uB2E4!"
    delayAfterPrevious: 1
  - triggerId: 15
    isMandatory: 0
    messageText: "\uB208\uC5D0 \uC798 \uB744\uB294 \uB2E8\uC810\uC774 \uC788\uB294
      \uAC74 \uC544\uC27D\uC9C0\uB9CC..."
    delayAfterPrevious: 1
  - triggerId: 15
    isMandatory: 0
    messageText: "\uC544\uBB34\uD2BC \uB300\uC751\uD558\uAE30 \uC5B4\uB824\uC6B8
      \uAC70\uB2E4!"
    delayAfterPrevious: 1
  - triggerId: 20
    isMandatory: 0
    messageText: "\uC774\uBC88\uC5D0\uB294 \uC9C4\uC9DC \uD2B9\uBCC4\uD55C \uCE5C\uAD6C\uB4E4\uC744
      \uB370\uB824\uC654\uB2E4!"
    delayAfterPrevious: 1
  - triggerId: 20
    isMandatory: 0
    messageText: "\uBE5B\uC758 \uC18D\uB3C4\uB85C \uC2DD\uBB3C\uC744 \uBA39\uC5B4
      \uCE58\uC6B0\uB294 \uBB34\uC9C0\uAC1C \uBC8C\uB808!"
    delayAfterPrevious: 1
  - triggerId: 20
    isMandatory: 0
    messageText: "\u3148... \uC808\uB300\uB85C \uC5B4\uB5A4 \uBC30\uAD00\uACF5 \uAC8C\uC784\uC744
      \uCC38\uACE0\uD574\uC11C \uB9CC\uB4E0 \uAC8C \uC544\uB2C8\uB2E4..."
